{
  "id": "piper",
  "name": "Piper",
  "vendor": "Rhasspy / OHF",
  "description": "Fast, lightweight neural voices that run in real time on any CPU, even a Raspberry Pi. Pick from the curated list or enter any voice from the Piper catalog, or a local .onnx file.",
  "tags": [
    "Real-time",
    "40+ languages",
    "CPU"
  ],
  "license": "GPL-3.0 · voices vary",
  "homepage": "https://github.com/OHF-Voice/piper1-gpl",
  "size": "≈ 100 MB + 20–120 MB per voice",
