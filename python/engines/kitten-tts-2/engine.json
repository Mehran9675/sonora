{
  "id": "kitten-tts-2",
  "name": "Kitten TTS 2",
  "vendor": "KittenML",
  "description": "1.7B speech language model with 47 built-in voices, zero-shot voice cloning from 5–30 s of audio, 20 languages and emotion tags. Runs on CPU, faster on a GPU or Apple silicon.",
  "tags": ["Voice cloning", "20 languages", "Emotion tags"],
  "license": "Apache-2.0 code · see model card",
  "homepage": "https://github.com/KittenML/KittenTTS",
  "size": "≈ 3 GB with PyTorch + 0.5–1 GB model",
  "accent": ["#f97316", "#ec4899"],
  "kind": "python",
  "python": "3.11",
  "install": [["kittenml"]],
  "clone": "optional",
  "transcript": "optional",
  "default_voice": "Bruno",
  "hint": "Tip: start with [joyful], [sad]… and add <laugh> or (((emphasis))) inline.",
  "options": [
    {"id": "weights", "label": "Weights", "type": "select", "scope": "load", "default": "packed",
     "help": "Compact downloads half as much (506 MB) for slightly lower quality.",
     "choices": [{"value": "packed", "label": "Full quality"}, {"value": "emb4", "label": "Compact"}]},
    {"id": "preset", "label": "Delivery", "type": "select", "default": "stable",
     "choices": [{"value": "stable", "label": "Stable"}, {"value": "expressive", "label": "Expressive"}]},
    {"id": "temperature", "label": "Temperature", "type": "number", "min": 0, "max": 1.5, "step": 0.05,
     "help": "0 keeps the preset's value"},
    {"id": "normalize", "label": "Expand numbers & dates", "type": "bool", "default": true},
    {"id": "seed", "label": "Seed", "type": "text", "keyboard": "number", "placeholder": "random", "help": "Same seed, same audio"}
  ]
}
