{
  "id": "chatterbox",
  "name": "Chatterbox",
  "vendor": "Resemble AI",
  "description": "Production-grade open model with strong zero-shot voice cloning and an emotion-exaggeration control. English, with a multilingual variant for 23 languages.",
  "tags": ["Voice cloning", "Emotion control", "GPU recommended"],
  "license": "MIT",
  "homepage": "https://github.com/resemble-ai/chatterbox",
  "size": "≈ 4 GB with PyTorch + model",
  "accent": ["#f43f5e", "#a855f7"],
  "kind": "python",
  "python": "3.11",
  "install": [["chatterbox-tts"]],
  "clone": "optional",
  "voices": [{"id": "", "name": "Default voice", "group": "Built-in"}],
  "options": [
    {"id": "exaggeration", "label": "Exaggeration", "type": "number", "min": 0.25, "max": 2, "step": 0.05, "default": 0.5},
    {"id": "cfg_weight", "label": "Pace / CFG", "type": "number", "min": 0, "max": 1, "step": 0.05, "default": 0.5},
    {"id": "temperature", "label": "Temperature", "type": "number", "min": 0.05, "max": 2, "step": 0.05, "default": 0.8}
  ]
}
